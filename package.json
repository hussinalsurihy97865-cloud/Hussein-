{
  "name": "eshrahli-ready-accountant-ad",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "render:vertical": "remotion render src/index.ts Ad-Vertical out/Ad-Vertical.mp4",
    "render:landscape": "remotion render src/index.ts Ad-Landscape out/Ad-Landscape.mp4",
    "render:stills": "remotion still src/index.ts Ad-Vertical out/check-vertical.png --frame=500 && remotion still src/index.ts Ad-Landscape out/check-landscape.png --frame=500"
  },
  "dependencies": {
    "@remotion/cli": "4.0.125",
    "@remotion/google-fonts": "4.0.125",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.125"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3"
  }
}
